VIAL_ENABLE = yes
OPT_DEFS += -DEH_HPD_FACTORY_LAYER_NAMES -DEH_ENCODER_SETTINGS -DEH_ENCODER_INTERVAL_SETTINGS -DEH_HPD_SIMPLE_AUTO_MOUSE_SETTINGS
SRC += keyboards/ergohaven/src/eh_encoder.c
ENCODER_ENABLE = yes
ENCODER_MAP_ENABLE = yes

POINTING_DEVICE_ENABLE = yes
